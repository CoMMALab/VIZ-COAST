<robot name="tetris_box_with_walls">
  <!-- Base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.27 0.05"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.27 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Front wall -->
  <link name="wall_front">
    <inertial>
      <origin xyz="0 -0.135 0.1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.135 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.01 0.30"/>
      </geometry>
      <material name="red_transparent">
        <color rgba="1 0 0 0.45"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.135 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.01 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- Back wall -->
  <link name="wall_back">
    <inertial>
      <origin xyz="0 0.135 0.1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0.135 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.01 0.30"/>
      </geometry>
      <material name="red_transparent">
        <color rgba="1 0 0 0.45"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.135 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.01 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- Left wall -->
  <link name="wall_left">
    <inertial>
      <origin xyz="-0.135 0 0.1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="-0.135 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.27 0.30"/>
      </geometry>
      <material name="red_transparent">
        <color rgba="1 0 0 0.45"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.135 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.27 0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- Right wall -->
  <link name="wall_right">
    <inertial>
      <origin xyz="0.135 0 0.1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0.135 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.27 0.30"/>
      </geometry>
      <material name="red_transparent">
        <color rgba="1 0 0 0.45"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.135 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.27 0.30"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_front" type="fixed">
    <parent link="base_link"/>
    <child link="wall_front"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_back" type="fixed">
    <parent link="base_link"/>
    <child link="wall_back"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_left" type="fixed">
    <parent link="base_link"/>
    <child link="wall_left"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_right" type="fixed">
    <parent link="base_link"/>
    <child link="wall_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
