<?xml version="1.0"?>
<robot name="cooking_pot">
  <!-- A shallow transparent pot.  Same 0.27x0.27 footprint as plate.urdf and
       lid.urdf so a lid covers it exactly, but only 0.10 deep: the iiwa's
       wrist has to descend inside to reach the contents, and the 0.20 depth of
       tetris_box.urdf makes that essentially unreachable (measured 0/30 IK
       successes).  Contents still sit below the rim, so a lid on top blocks
       access to them, which is the property the domain relies on. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.27 0.05"/>
      </geometry>
      <material name="pot_red">
        <color rgba="0.8 0.15 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.27 0.05"/>
      </geometry>
    </collision>
  </link>

  <link name="wall_front">
    <inertial>
      <origin xyz="0 -0.13 0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.13 0.10" rpy="0 0 0"/>
      <geometry><box size="0.27 0.01 0.10"/></geometry>
      <material name="pot_transparent"><color rgba="0.8 0.15 0.1 0.35"/></material>
    </visual>
    <collision>
      <origin xyz="0 -0.13 0.10" rpy="0 0 0"/>
      <geometry><box size="0.27 0.01 0.10"/></geometry>
    </collision>
  </link>

  <link name="wall_back">
    <inertial>
      <origin xyz="0 0.13 0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0.13 0.10" rpy="0 0 0"/>
      <geometry><box size="0.27 0.01 0.10"/></geometry>
      <material name="pot_transparent"><color rgba="0.8 0.15 0.1 0.35"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.13 0.10" rpy="0 0 0"/>
      <geometry><box size="0.27 0.01 0.10"/></geometry>
    </collision>
  </link>

  <link name="wall_left">
    <inertial>
      <origin xyz="-0.13 0 0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="-0.13 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.01 0.27 0.10"/></geometry>
      <material name="pot_transparent"><color rgba="0.8 0.15 0.1 0.35"/></material>
    </visual>
    <collision>
      <origin xyz="-0.13 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.01 0.27 0.10"/></geometry>
    </collision>
  </link>

  <link name="wall_right">
    <inertial>
      <origin xyz="0.13 0 0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0.13 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.01 0.27 0.10"/></geometry>
      <material name="pot_transparent"><color rgba="0.8 0.15 0.1 0.35"/></material>
    </visual>
    <collision>
      <origin xyz="0.13 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.01 0.27 0.10"/></geometry>
    </collision>
  </link>

  <joint name="base_to_front" type="fixed">
    <parent link="base_link"/><child link="wall_front"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_back" type="fixed">
    <parent link="base_link"/><child link="wall_back"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_left" type="fixed">
    <parent link="base_link"/><child link="wall_left"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_right" type="fixed">
    <parent link="base_link"/><child link="wall_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
